From 04046b44a81ad54af0f2e7e3fbf3889c07e77b58 Mon Sep 17 00:00:00 2001
From: Nicolas Primeau <nicolas.primeau@gmail.com>
Date: Fri, 23 Oct 2026 17:20:36 -0400
Subject: [PATCH] kv-cache : per-layer KV cache types via LLAMA_KV_TYPE_PLAN
 (prototype)

LLAMA_KV_TYPE_PLAN="k0=f16,v0=q5_1,k7=q8_0" overrides the K/V cache type of
individual layers; unlisted layers keep --cache-type-k/--cache-type-v.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01D217auYtCY8WDut3u2AYqY
---
 src/llama-kv-cache.cpp | 46 ++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 44 insertions(+), 2 deletions(-)

diff --git a/src/llama-kv-cache.cpp b/src/llama-kv-cache.cpp
index 6f0e3f7..d9f33fe 100644
--- a/src/llama-kv-cache.cpp
+++ b/src/llama-kv-cache.cpp
@@ -11,6 +11,7 @@
 #include <cstring>
 #include <limits>
 #include <map>
+#include <sstream>
 #include <stdexcept>
 #include <unordered_map>
 
@@ -62,6 +63,38 @@ static void ggml_gen_hadamard(ggml_tensor * tensor) {
 // llama_kv_cache
 //
 
+// per-layer KV cache types, e.g. LLAMA_KV_TYPE_PLAN="k0=f16,v0=q5_1,k7=q8_0"
+// layers not listed keep the global --cache-type-k / --cache-type-v
+static std::map<std::pair<char, uint32_t>, ggml_type> llama_kv_type_plan_parse(const char * plan) {
+    std::map<std::pair<char, uint32_t>, ggml_type> res;
+    if (plan == nullptr) {
+        return res;
+    }
+    std::string item;
+    std::stringstream ss(plan);
+    while (std::getline(ss, item, ',')) {
+        const size_t eq = item.find('=');
+        if (item.size() < 4 || (item[0] != 'k' && item[0] != 'v') || eq == std::string::npos) {
+            throw std::runtime_error("invalid LLAMA_KV_TYPE_PLAN entry: " + item);
+        }
+        const uint32_t il   = std::stoul(item.substr(1, eq - 1));
+        const std::string t = item.substr(eq + 1);
+        ggml_type type = GGML_TYPE_COUNT;
+        for (int i = 0; i < GGML_TYPE_COUNT; ++i) {
+            const char * name = ggml_type_name((ggml_type) i);
+            if (name && t == name) {
+                type = (ggml_type) i;
+                break;
+            }
+        }
+        if (type == GGML_TYPE_COUNT) {
+            throw std::runtime_error("unknown type in LLAMA_KV_TYPE_PLAN: " + t);
+        }
+        res[{item[0], il}] = type;
+    }
+    return res;
+}
+
 llama_kv_cache::llama_kv_cache(
         const llama_model & model,
         const llama_hparams & hparams,
@@ -162,6 +195,15 @@ llama_kv_cache::llama_kv_cache(
 
     const bool is_mla = hparams.is_mla();
 
+    const auto type_plan = llama_kv_type_plan_parse(getenv("LLAMA_KV_TYPE_PLAN"));
+    auto plan_type = [&](char kv, uint32_t il, ggml_type def) {
+        const auto it = type_plan.find({kv, il});
+        return it == type_plan.end() ? def : it->second;
+    };
+    if (!type_plan.empty()) {
+        LLAMA_LOG_INFO("%s: using per-layer KV type plan with %zu overrides\n", __func__, type_plan.size());
+    }
+
     for (uint32_t il = 0; il < n_layer; il++) {
         if (!hparams.has_kv(il)) {
             LLAMA_LOG_DEBUG("%s: layer %3d: does not have KV cache\n", __func__, il);
@@ -230,8 +272,8 @@ llama_kv_cache::llama_kv_cache(
         const bool has_k = true;
         const bool has_v = !is_mla;
 
-        ggml_tensor * k = has_k ? ggml_new_tensor_3d(ctx, type_k, n_embd_k_gqa, kv_size, n_stream) : nullptr;
-        ggml_tensor * v = has_v ? ggml_new_tensor_3d(ctx, type_v, n_embd_v_gqa, kv_size, n_stream) : nullptr;
+        ggml_tensor * k = has_k ? ggml_new_tensor_3d(ctx, plan_type('k', il, type_k), n_embd_k_gqa, kv_size, n_stream) : nullptr;
+        ggml_tensor * v = has_v ? ggml_new_tensor_3d(ctx, plan_type('v', il, type_v), n_embd_v_gqa, kv_size, n_stream) : nullptr;
 
         has_k && ggml_format_name(k, "cache_%sk_l%d", name_tag, il);
         has_v && ggml_format_name(v, "cache_%sv_l%d", name_tag, il);
-- 
